# Restore old style debuginfo creation for rpm >= 4.14.
%undefine _debugsource_packages
%undefine _debuginfo_subpackages

%global libmariadb_commit 51b2a62
%global wolfssl_commit 8970ff4
%global mariadb_version 10.4.34.1

# -*- rpm-spec -*-
Summary:        MariaDB: a very fast and robust SQL database server
Name:           MariaDB
%if "0%{?_version}" == "0"
Version:        10.4.34.1
%else
Version:        %{_version}
%endif
%if "0%{?_release}" == "0"
Release:        4%{?dist}
%else
Release:        %{_release}%{?dist}
%endif
License:        GPLv2
Group:          Applications/Databases
Vendor:         MariaDB Foundation
BuildRoot:      %_topdir/mariadb-%{version}

Source0:  mariadb-server-mariadb-%{mariadb_version}.tar.gz
Source1:  https://github.com/MariaDB/mariadb-connector-c/archive/%{libmariadb_commit}/mariadb-connector-c-%{libmariadb_commit}.tar.gz
Source2:  https://github.com/wolfSSL/wolfssl/archive/%{wolfssl_commit}/wolfssl-%{wolfssl_commit}.tar.gz

Patch1: 0001-Allow-building-with-flto-flag.patch
# The CONNECT adapter needs a const-correct libxml2 error API on EL10+.
%if 0%{?rhel} >= 10
Patch2: 0002-CONNECT-support-libxml2-2.12-errors.patch
%endif

BuildRequires: bison boost-devel coreutils checkpolicy binutils make
%if 0%{?rhel} == 7
# EL7's stock CMake and GCC are too old. Use the versioned toolchain.
BuildRequires: cmake3 devtoolset-11-gcc-c++
%else
BuildRequires: cmake
%endif
BuildRequires: libcurl-devel ncurses-devel systemtap-sdt-devel libevent-devel libaio-devel
BuildRequires: cracklib-devel glibc-devel zlib-devel xz-devel systemd-devel
BuildRequires: Judy-devel krb5-devel libxml2-devel unixODBC-devel unixODBC
BuildRequires: openssl-devel pam-devel readline-devel policycoreutils libzstd-devel
BuildRequires: snappy-devel lz4-devel gnutls-devel gperftools-devel
%if 0%{?rhel} != 7
BuildRequires: llvm lld clang
%endif
BuildRequires: procps-ng perl

# EL7 still gets crypt(3) development headers from glibc. EL8+ split them into
# libxcrypt-devel.
%if 0%{?rhel} >= 8
BuildRequires: libxcrypt-devel
%endif

# pkgconf-pkg-config replaced the legacy pkgconfig package starting with EL8.
%if 0%{?rhel} == 7
BuildRequires: pkgconfig
%else
BuildRequires: pkgconf-pkg-config
%endif

# OpenJDK 8 is available through EL9, while EL10 ships newer supported JDKs.
%if 0%{?rhel} >= 10
BuildRequires: java-21-openjdk java-21-openjdk-headless
%else
BuildRequires: java-1.8.0-openjdk java-1.8.0-openjdk-headless
%endif

%define debug_package %{nil}

%define _rpmdir %_topdir/RPMS
%define _srcrpmdir %_topdir/SRPMS

%define _unpackaged_files_terminate_build 0


%define mysql_vendor MariaDB Foundation
%define mysqlversion %{version}
%define mysqlbasedir /usr
%define mysqldatadir /var/lib/mysql
%define mysqld_user  mysql
%define mysqld_group mysql
%define _bindir     /usr/bin
%define _sbindir    /usr/sbin
%define _sysconfdir /etc
%define restart_flag_dir %{_localstatedir}/lib/rpm-state/mariadb
%define restart_flag %{restart_flag_dir}/need-restart

%define pretrans %{nil}

%{?filter_setup:
%filter_provides_in \.\(test\|result\|h\|cc\|c\|inc\|opt\|ic\|cnf\|rdiff\|cpp\)$
%filter_requires_in \.\(test\|result\|h\|cc\|c\|inc\|opt\|ic\|cnf\|rdiff\|cpp\)$
%filter_from_provides /perl(\(mtr\|My::\)/d
%filter_from_requires /\(lib\(ft\|lzma\|tokuportability\)\)\|\(perl(\(.*mtr\|My::\|.*HandlerSocket\|Mysql\)\)/d
%filter_setup
}

%define ignore #



%description
MariaDB: a very fast and robust SQL database server

It is GPL v2 licensed, which means you can use the it free of charge under the
conditions of the GNU General Public License Version 2 (http://www.gnu.org/licenses/).

MariaDB documentation can be found at https://mariadb.com/kb
MariaDB bug reports should be submitted through https://jira.mariadb.org

# This is a shortcutted spec file generated by CMake RPM generator
# we skip _install step because CPack does that for us.
# We do only save CPack installed tree in _prepr
# and then restore it in build.
%prep
%setup -q -c
%setup -q -T -D -a 1
mv -fT mariadb-connector-c-%{libmariadb_commit}* mariadb-server-mariadb-%{mariadb_version}/libmariadb
%setup -q -T -D -a 2
mv -fT wolfssl-%{wolfssl_commit}* mariadb-server-mariadb-%{mariadb_version}/extra/wolfssl/wolfssl

%patch1 -p1 -d mariadb-server-mariadb-%{mariadb_version}/
%if 0%{?rhel} >= 10
%patch2 -p1 -d mariadb-server-mariadb-%{mariadb_version}/
%endif

%build
mkdir cpack_rpm_build_dir
cd cpack_rpm_build_dir
%if 0%{?rhel} == 7
# Modern GCC and CMake 3 from OL7 Software Collections / developer EPEL.
# Keep LTO while dropping Clang-specific flags and lld on EL7.
. /opt/rh/devtoolset-11/enable
CMAKE_BIN=/usr/bin/cmake3
CPACK_BIN=/usr/bin/cpack3
C_COMPILER="$(command -v gcc)"
CXX_COMPILER="$(command -v g++)"
LINKER="$(command -v ld)"
AR="$(command -v gcc-ar)"
export CPPFLAGS='-ffunction-sections -fdata-sections -flto'
%else
CMAKE_BIN=/usr/bin/cmake
CPACK_BIN=/usr/bin/cpack
C_COMPILER=/usr/bin/clang
CXX_COMPILER=/usr/bin/clang++
LINKER=/usr/bin/lld
AR=/usr/bin/llvm-ar
export CPPFLAGS='-ffunction-sections -fdata-sections -Wl,--gc-sections -Wl,--strip-all -Wno-unused-command-line-argument -fuse-ld=lld -fvectorize -fslp-vectorize -fwhole-program-vtables -flto'
%endif
export LDFLAGS='-Wl,--gc-sections -Wl,--strip-all'

%ifarch x86_64
# Keep the binary ISA baseline aligned with the selected EL generation.
# GCC/Clang spell the x86-64-v1 baseline simply as "x86-64".
%if 0%{?rhel} >= 10
export CPPFLAGS="${CPPFLAGS} -march=x86-64-v3 -mtune=generic"
%else
%if 0%{?rhel} >= 9
export CPPFLAGS="${CPPFLAGS} -march=x86-64-v2 -mtune=westmere"
%else
export CPPFLAGS="${CPPFLAGS} -march=x86-64 -mtune=westmere"
%endif
%endif
%endif

"$CMAKE_BIN"  -DRPM=rh%{suffix:%dist} \
                  -DLZ4_LIBS=%{_libdir}/liblz4.so \
                  -DWITH_INNODB_LZ4=ON \
                  -DWITH_ROCKSDB_LZ4=ON \
                  -DCMAKE_BUILD_TYPE=Release \
                  -DCMAKE_C_COMPILER="$C_COMPILER" \
                  -DCMAKE_CXX_COMPILER="$CXX_COMPILER" \
                  -DCMAKE_LINKER="$LINKER" \
                  -DCMAKE_AR="$AR" \
                  -DCMAKE_C_FLAGS="$CPPFLAGS" \
                  -DCMAKE_CXX_FLAGS="$CPPFLAGS" \
                  -DCMAKE_EXE_LINKER_FLAGS="-ltcmalloc_minimal $LDFLAGS" \
                  -DBUILD_CONFIG=mysql_release \
                  -DWITH_EMBEDDED_SERVER=no \
                  -DWITH_SAFEMALLOC=OFF \
                  -DWITH_SSL=bundled \
                  -DWITH_JEMALLOC=no \
                  -DWITH_WSREP=no \
                  -DWITH_UNIT_TESTS=no \
                  -DPLUGIN_TOKUDB=NO \
                  -DPLUGIN_SPIDER=NO \
                  -DPLUGIN_SPHINX=NO \
                  -DCPACK_PACKAGING_INSTALL_PREFIX=/ ../mariadb-server-mariadb-%{mariadb_version}
make %{?_smp_mflags}

%install

cd cpack_rpm_build_dir
%if 0%{?rhel} == 7
CPACK_BIN=/usr/bin/cpack3
%else
CPACK_BIN=/usr/bin/cpack
%endif
"$CPACK_BIN" -D CPACK_RPM_PACKAGE_VERSION=%{version} -D CPACK_RPM_PACKAGE_RELEASE=%{release} -G RPM
mv *.rpm %_rpmdir

%clean

